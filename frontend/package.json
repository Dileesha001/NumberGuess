{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "Developer",
  "description": "Number Guessing Game Desktop Application",
  "scripts": {
    "dev": "vite",
